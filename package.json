{
    "name": "@iringo/siri",
    "organizationName": " iRingo",
    "displayName": " iRingo: ⭕ Siri",
    "description": "全面自定义「Siri」中的「Siri 请求」和「Siri 建议」功能。",
    "homepage": "https://NSRingo.github.io/guide/Siri",
    "openUrl": "http://boxjs.com/#/app/iRingo.Siri",
    "icon": "https://developer.apple.com/assets/elements/icons/siri/siri-128x128.png",
    "keywords": [],
    "contributors": [
        "VirgilClyne[https://github.com/VirgilClyne]"
    ],
    "system": [
        "iOS",
        "iPadOS",
        "macOS"
    ],
    "systemVersion": 15,
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/NSRingo/Siri.git"
    },
    "directories": {
        "example": "example"
    },
    "scripts": {
        "build": "rollup -c",
        "build:dev": "rollup -c rollup.dev.config.mjs",
        "dev:pages": "npx wrangler pages dev --port 8787",
        "dev:workers": "npx wrangler dev -c wrangler.workers.jsonc",
        "dev:vercel": "npx vercel dev --listen 8787",
        "deploy:pages": "npx wrangler pages deploy",
        "deploy:workers": "npx wrangler deploy --minify -c wrangler.workers.jsonc",
        "deploy:vercel": "npx vercel deploy --prod",
        "sgmoudle:dev": "sgmoudle dev",
        "update": "npm update --save",
        "dev": "npm-run-all --parallel build:dev build:dev-args",
        "build:dev-args": "npm-run-all --serial build:dev-args:*",
        "build:release-args": "npm-run-all --serial build:release-args:*",
        "build:full-args": "npm-run-all --serial build:full-args:*",
        "build:args": "npm-run-all --serial build:release-args build:full-args",
        "build:dev-args:siri": "arguments-builder build -c arguments-builder.dev.config.ts",
        "build:release-args:siri": "arguments-builder build -c arguments-builder.release.config.ts",
        "build:full-args:siri": "arguments-builder boxjs -c arguments-builder.full.config.ts",
        "build:dev-args:search": "arguments-builder build -c arguments-builder.Search.dev.config.ts",
        "build:release-args:search": "arguments-builder build -c arguments-builder.Search.release.config.ts",
        "build:full-args:search": "arguments-builder boxjs -c arguments-builder.Search.full.config.ts",
        "build:dev-args:spotlight": "arguments-builder build -c arguments-builder.Spotlight.dev.config.ts",
        "build:release-args:spotlight": "arguments-builder build -c arguments-builder.Spotlight.release.config.ts",
        "build:full-args:spotlight": "arguments-builder boxjs -c arguments-builder.Spotlight.full.config.ts",
        "dts": "npm-run-all --serial dts:*",
        "dts:siri": "arguments-builder dts -c arguments-builder.full.config.ts",
        "dts:spotlight": "arguments-builder dts -c arguments-builder.Search.full.config.ts"
    },
    "browserslist": [
        "iOS >= 15"
    ],
    "devDependencies": {
        "@biomejs/biome": "2.1.4",
        "@iringo/arguments-builder": "^1.8.5",
        "@iringo/sgmoudle-tools": "^1.2.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "npm-run-all": "^4.1.5",
        "rollup": "^4.62.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@nsnanocat/grpc": "^1.1.0",
        "@nsnanocat/util": "^2.7.5",
        "@nsringo/parsec": "^1.0.0",
        "@protobuf-ts/runtime": "^2.9.3",
        "pako": "^2.1.0",
        "hono": "^4.12.31",
        "fetch-cookie": "^3.2.0",
        "node-fetch": "^3.3.2"
    },
    "workspaces": [
        "packages/*"
    ],
    "overrides": {
        "@iringo/surge2egern": {
            "puppeteer": "25.7.0"
        }
    }
}
