[Rule]
# > Look Up (Only for Wikipedia@macOS, Surge Enhance Mode enabled required)
RULE-SET,https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/LookUp.Wikipedia.list,\{{{Proxy}}}

[Script]
# Bag (iOS/macOS)
🔍 Spotlight.Bag.request = type=http-request, pattern=^https?:\/\/api\.smoot\.apple\.(com|cn)\/bag, requires-body=0, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js, argument={{{scriptParams}}}
🔍 Spotlight.Bag.response = type=http-response, pattern=^https?:\/\/api\.smoot\.apple\.(com|cn)\/bag, requires-body=1, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/response.dev.bundle.js, argument={{{scriptParams}}}
# Siri Suggestions & Look Up Search (iOS/macOS)
🔍 Spotlight.Search.request = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/search, requires-body=0, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js, argument={{{scriptParams}}}
# Siri Infomation Card (macOS)
🔍 Spotlight.Card.request = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/card, requires-body=0, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js, argument={{{scriptParams}}}
# Flight Search (iOS/macOS)
🔍 Spotlight.Flight.request = type=http-request, pattern=^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/flight, requires-body=0, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js, argument={{{scriptParams}}}

[MITM]
hostname = %APPEND% api*.smoot.apple.com, api.smoot.apple.cn
