#[rewrite_local]
# 🔍 Search Bag (iOS/macOS)
^https?:\/\/api\.smoot\.apple\.(com|cn)\/bag url script-request-header https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js
^https?:\/\/api\.smoot\.apple\.(com|cn)\/bag url script-response-body https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/response.dev.bundle.js
# 🔍 Siri Suggestions & Look Up Search (iOS/macOS)
^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/search url script-request-header https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js
# 🔍 Search Infomation Card (macOS)
^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/card url script-request-header https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js
# 🔍 Search Flight Search (iOS/macOS)
^https?:\/\/api(2|-.+)\.smoot\.apple\.(com|cn)\/flight url script-request-header https://gist.githubusercontent.com/VirgilClyne/b5f0de011fabe5637ff53e585e9d061d/raw/request.dev.bundle.js

#[mitm]
hostname = api*.smoot.apple.com, api.smoot.apple.cn
